# ============================================================================
# SENTINEL OPS - KONFIGURASI LINGKUNGAN
# ============================================================================
# Salin berkas ini menjadi .env lalu sesuaikan.
#   cp .env.example .env
#
# Tanpa konfigurasi apa pun, sistem berjalan dalam Mode Demo: database
# PostgreSQL tertanam (PGlite), tanpa instalasi server. Cukup:
#   npm install && npm run db:migrate && npm run db:seed && npm run dev
# ============================================================================

# ----------------------------------------------------------------------------
# 1. MODE BASIS DATA
# ----------------------------------------------------------------------------
# MODE DEMO (default) - PostgreSQL tertanam, data disimpan di direktori lokal.
# Biarkan DATABASE_URL kosong. Tambahkan tanda kutip agar tidak dianggap kosong
# oleh shell tertentu.
DATABASE_URL=""
PGLITE_DATA_DIR=".data/pglite"

# MODE PRODUKSI - PostgreSQL server (Supabase, Neon, Railway, VPS, RDS).
# Isi dengan URI standar; driver otomatis beralih, tidak perlu ubah kode.
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sentinel_ops?sslmode=require"

# Variabel lama, hanya untuk kompatibilitas. Tidak perlu diisi bila DATABASE_URL
# sudah menentukan mode. Nilai yang diterima: postgres-js | pg | postgres.
# DATABASE_DRIVER=

# ----------------------------------------------------------------------------
# 2. KUNCI KEAMANAN & KRIPTOGRAFI
# ----------------------------------------------------------------------------
# Jalankan `npm run secrets:generate` untuk membuat kunci produksi baru.
#
# Di Mode Demo, kedua nilai di bawah boleh dikosongkan: sistem memakai fallback
# lokal yang stabil sehingga demo dan seluruh pengujian tetap berjalan.
#
# Di Mode Produksi (DATABASE_URL terisi + NODE_ENV=production), keduanya WAJIB
# diisi dengan nilai acak. Aplikasi menolak berjalan bila masih memakai nilai
# contoh di bawah.
VAULT_MASTER_KEY=""
SESSION_SECRET=""

# Nilai contoh yang akan DITOLAK di produksi (jangan dipakai):
# VAULT_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# SESSION_SECRET="sentinel-ops-local-dev-session-secret-change-in-prod"

# Setel ke "true" hanya bila Anda sengaja menjalankan build simulasi produksi
# TANPA PostgreSQL sungguhan. Jangan dipakai untuk layanan nyata.
# ALLOW_DEMO_SECRETS="false"

# ----------------------------------------------------------------------------
# 3. APLIKASI
# ----------------------------------------------------------------------------
# URL publik, dipakai untuk tautan laporan dan penentuan cookie Secure.
APP_URL="http://localhost:3000"

# Paksa flag Secure pada cookie sesi. Biarkan kosong agar otomatis mengikuti
# skema APP_URL atau header x-forwarded-proto.
# SESSION_COOKIE_SECURE=

# ----------------------------------------------------------------------------
# 4. PEMINDAI KEAMANAN
# ----------------------------------------------------------------------------
SCANNER_HTTP_TIMEOUT_MS="10000"
# SIMULATED (default, tanpa permintaan keluar) atau LIVE
SCANNER_DEFAULT_MODE="SIMULATED"
SCANNER_USER_AGENT="SentinelOps-SecurityMonitor/1.0"
